# Flask Environment Configuration
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=change-this-to-a-very-strong-secret-key-in-production

# Database Configuration (Defaults to database/society.db)
DATABASE_PATH=database/society.db

# Mail / SMTP Configuration (Optional, for password resets)
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@society.local
